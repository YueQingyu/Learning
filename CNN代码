#池化层
def my_maxpool2d(img, pool_size=2, stride=2):
    """
    img: 输入特征图，形状 (H, W, C)
    pool_size: 池化窗口大小（整数，正方形）
    stride: 步长（整数）
    返回: 池化后的特征图，形状 (H_out, W_out, C)
    """
    H, W, C = img.shape
    ph = pw = pool_size
    s = stride
    H_out = (H - ph) // s + 1
    W_out = (W - pw) // s + 1
    out = np.zeros((H_out, W_out, C))
    for c in range(C):
        for i in range(H_out):
            for j in range(W_out):
                window = img[i*s:i*s+ph, j*s:j*s+pw, c]
                out[i, j, c] = np.max(window)
    return out

# 对卷积输出做池化（垂直边缘特征图）
pooled = my_maxpool2d(output, pool_size=2, stride=2)
print("池化后形状:", pooled.shape)

