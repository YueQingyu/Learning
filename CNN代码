#全连接
#全连接层（前向传播）
class MyLinear:
    def __init__(self, in_features, out_features):
        self.W = np.random.randn(in_features, out_features) * 0.01
        self.b = np.zeros((1, out_features))
    def forward(self, x):
        return np.dot(x, self.W) + self.b

# 对池化后的垂直边缘特征图进行展平
flatten = pooled.reshape(1, -1)
print("展平后形状:", flatten.shape)

# 定义全连接层：输入961维，输出2维
fc = MyLinear(961, 2)
scores = fc.forward(flatten)
print("全连接层输出（分类分数）:", scores)

# 应用softmax得到概率
def softmax(x):
    exp_x = np.exp(x - np.max(x, axis=1, keepdims=True))
    return exp_x / np.sum(exp_x, axis=1, keepdims=True)

probs = softmax(scores)
print("概率分布:", probs)

predicted_class = np.argmax(probs, axis=1)[0]
print("预测类别索引:", predicted_class)
if predicted_class == 0:
    print("模型认为：这张图更像“猫”")
else:
    print("模型认为：这张图更像“非猫”")


    # 定义带反向传播的全连接层
    class MyLinearWithTrain:
        def __init__(self, in_dim, out_dim):
            self.W = np.random.randn(in_dim, out_dim) * 0.01
            self.b = np.zeros(out_dim)

        def forward(self, x):
            self.x = x
            return np.dot(x, self.W) + self.b

        def backward(self, grad_out, lr):
            grad_W = np.dot(self.x.T, grad_out)
            grad_b = np.sum(grad_out, axis=0)
            grad_in = np.dot(grad_out, self.W.T)
            self.W -= lr * grad_W
            self.b -= lr * grad_b
            return grad_in


    # 手写交叉熵损失
    def cross_entropy_loss(scores, label):
        # scores: (1,2), label: 0或1
        exp_scores = np.exp(scores - np.max(scores))
        probs = exp_scores / np.sum(exp_scores)
        loss = -np.log(probs[0, label] + 1e-8)
        grad = probs.copy()
        grad[0, label] -= 1
        return loss, grad


    # 用当前猫图片的特征训练全连接层
    print("\n" + "=" * 50)
    print("开始训练：使用当前猫图片特征")
    print("=" * 50)

    # 准备训练数据
    X_train = flatten  # (1, 961) 当前猫图片的特征
    y_train = np.array([1])  # 标签：1 表示猫

    # 创建带训练能力的全连接层
    fc_train = MyLinearWithTrain(961, 2)

    # 训练前预测
    scores_before = fc_train.forward(X_train)
    probs_before = softmax(scores_before)
    print(f"\n训练前预测：")
    print(f"  分数: {scores_before[0]}")
    print(f"  概率: {probs_before[0]}")
    print(f"  预测: {'猫' if np.argmax(probs_before) == 1 else '非猫'}")

    # 训练循环
    lr = 0.01
    epochs = 200
    losses = []

    for epoch in range(epochs):
        # 前向传播
        scores = fc_train.forward(X_train)
        loss, grad = cross_entropy_loss(scores, y_train[0])
        losses.append(loss)

        # 反向传播
        fc_train.backward(grad, lr)

        if epoch % 50 == 0:
            print(f"Epoch {epoch:3d}, Loss = {loss:.4f}")

    # 训练后
    scores_after = fc_train.forward(X_train)
    probs_after = softmax(scores_after)
    print(f"\n训练后预测：")
    print(f"  分数: {scores_after[0]}")
    print(f"  概率: {probs_after[0]}")
    print(f"  预测: {'猫' if np.argmax(probs_after) == 1 else '非猫'}")

    # 绘制损失曲线
    plt.figure()
    plt.plot(losses)
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.title('Training Loss on Single Cat Image')
    plt.show()


